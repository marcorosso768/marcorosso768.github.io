---
layout: default
---
<div class="post">
  {% comment %}
    Intestazione a griglia: a sinistra nome, posizione e affiliazioni, a destra la foto.
    Sotto, a tutta larghezza, la citazione (front matter: quote.text e quote.source).
    Stili in _layout.scss (.about-header).
  {% endcomment %}
  <header class="post-header about-header">
    <h1 class="post-title">
      {% if site.title != 'blank' %}
        <span class="about-first-name">
          {{ site.first_name }}
          {{ site.middle_name -}}
        </span>
        <span class="fw-bold">{{ site.last_name }}</span>
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle != 'blank' %}
      {% comment %}
        Un sottotitolo con blocchi (<div>) non può stare dentro <p>: il browser chiuderebbe il <p> prima del
        <div> e aggiungerebbe un <p> vuoto alla fine. Si scrive direttamente la struttura che il browser costruiva.
      {% endcomment %}
      {% if page.subtitle contains '<div' %}
        <p class="desc"></p>
        {{ page.subtitle }}
      {% else %}
        <p class="desc">{{ page.subtitle }}</p>
      {% endif %}
    {% endif %}
    {% if page.profile %}
      <div class="profile">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
        rounded' %}
          {% endif %}
          {% comment %}larghezza della foto nell'intestazione (_layout.scss, .about-header): 190px da 576px, 112px sotto{% endcomment %}
          {% capture sizes %}(min-width: 576px) 190px, 112px{% endcapture %}
          {% assign profile_base = page.profile.image | split: '_640.webp' | first %}
          {% if page.profile.image contains '_640.webp' %}
            {% capture profile_srcset %}{{ profile_base | prepend: '/assets/img/' | append: '_360.webp' | relative_url }} 360w, {{ profile_base | prepend: '/assets/img/' | append: '_540.webp' | relative_url }} 540w, {{ page.profile.image | prepend: '/assets/img/' | relative_url }} 640w{% endcapture %}
          {% endif %}
          {%
            include figure.liquid loading="eager" fetchpriority="high" path=profile_image_path class=profile_image_class sizes=sizes srcset=profile_srcset alt=page.profile.image_alt width="640" height="640"
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
    {% if page.quote %}
      <div class="about-quote-block">
        <p class="about-quote">{{ page.quote.text }}</p>
        <div class="about-quote-source">
          <div class="about-quote-source__spacer"></div>
          <span class="about-quote-source__text">{{ page.quote.source }}</span>
        </div>
      </div>
    {% endif %}
  </header>

  <article>
    <div class="clearfix about-content">{{ content }}</div>
    <div class="about-gap about-gap--end"></div>
    <hr class="about-rule">

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a
          class="news-effect"
          href="{% case site.active_lang %}{% when 'it' %}{{ '/it/novità/' | relative_url }}{% when 'es' %}{{ '/es/novedades/' | relative_url }}{% else %}{{ '/news/' | relative_url }}{% endcase %}"
        >
          {{ site.data[site.active_lang].strings.news }}
        </a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a class="news-effect" href="{{ '/blog/' | relative_url }}">{{ site.data[site.active_lang].strings.latest_posts }}</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <hr class="about-rule">
      <div class="social">
        <div class="contact-note">
          {{ site.data[site.active_lang].strings.social_note }}
        </div>

        <div class="contact-icons about-contact-icons">
          <div>
            {% include social.liquid %}
          </div>
        </div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
