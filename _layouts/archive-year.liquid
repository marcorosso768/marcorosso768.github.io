---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title"><i class="fa-solid fa-calendar fa-sm"></i> {{ page.date | date: '%Y' }}</h1>
    <p class="post-description">{{ site.data[site.active_lang].strings.archive_year }}</p>
  </header>

  <article class="archive">
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for post in page.posts %}
          <tr>
            <th scope="row">{% include date_format.liquid format='short' date=post.date %}</th>
            <td>
              {% comment %}senza redirect il link va al post (prima "post.redirect == blank" era falso con redirect assente e il link restava vuoto){% endcomment %}
              {% if post.redirect contains '://' %}
                <a class="post-link" href="{{ post.redirect }}">{{ post.title }}</a>
              {% elsif post.redirect and post.redirect != '' %}
                <a class="post-link" href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
              {% else %}
                <a class="post-link" href="{{ post.url | relative_url }}">{{ post.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </article>
</div>
