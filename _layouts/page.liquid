---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.course_back %}
    {% include courses/back.liquid %}
  {% endif %}
  <header class="post-header">
    {% if page.title and page.title != '' %}
      <h1 class="post-title text-theme">{{ page.title }}</h1>
    {% endif %}
    {% if page.subtitle %}
      {% comment %}
        Un sottotitolo con blocchi (<div>) non può stare dentro <p>: il browser chiuderebbe il <p> prima del
        <div> e aggiungerebbe un <p> vuoto alla fine. Si scrive direttamente la struttura che il browser costruiva.
      {% endcomment %}
      {% if page.subtitle contains '<div' %}
        <p class="desc"></p>
        {{ page.subtitle }}
      {% else %}
        <p class="desc">{{ page.subtitle }}</p>
      {% endif %}
    {% endif %}
    {% if page.description %}
      <p class="post-description">
        {% if page.description_format == 'multiline' %}
          <em>{{ page.description | newline_to_br }}</em>
        {% else %}
          {{ page.description }}
        {% endif %}
      </p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
