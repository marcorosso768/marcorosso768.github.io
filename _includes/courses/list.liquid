{%- comment -%}
  Elenco dei file di una sezione (usato da courses/page.liquid). Parametri: items, icon, list_class.
  Usa le variabili course, course_text, course_text_en e labels assegnate in courses/page.liquid.
  Titolo: quello di courses_text.yml nella lingua della pagina; se manca, quello inglese (courses_text.yml in
  inglese, poi title in courses.yml). Un titolo inglese in una pagina it/es ha lang="en" (lettori di schermo).
{%- endcomment -%}
<ul class="{{ include.list_class }}">
  {%- for item in include.items -%}
    {%- assign name = item.file | default: item.notebook -%}
    {%- assign title = course_text.titles[name] -%}
    {%- assign title_lang = null -%}
    {%- unless title -%}
      {%- assign title = course_text_en.titles[name] | default: item.title -%}
      {%- unless site.active_lang == 'en' -%}
        {%- assign title_lang = 'en' -%}
      {%- endunless -%}
    {%- endunless %}
    {%- if item.notebook -%}
      {%- assign url = course.folder | append: item.notebook | prepend: course.viewer -%}
    {%- elsif item.translations[site.active_lang] -%}
      {%- assign url = item.translations[site.active_lang] | replace: ' ', '%20' -%}
    {%- else -%}
      {%- assign url = course.folder | append: item.file | replace: ' ', '%20' -%}
    {%- endif %}
    <li class="course-entry indented">
      <i class="{{ include.icon }} fa-fw"></i>
      <span>
        {%- if item.lecture -%}
          {{- course_text.lecture }}
          {{ item.lecture }}:
        {% elsif item.prefix -%}
          {{- item.prefix }}:
        {% endif -%}
        <a
          href="{{ url }}"
          {% if title_lang %}
            lang="{{ title_lang }}"
          {% endif %}
        >
          {{- title | escape -}}
        </a>
        {%- if item.updated -%}
          {%- assign date = item.updated | split: '-' -%}
          {%- assign month_index = date[1] | plus: 0 | minus: 1 -%}
          {%- if date.size > 2 -%}
            {%- assign day = date[2] | plus: 0 -%}
            {%- assign month = labels.months[month_index] -%}
            {%- assign formatted = labels.day_month_year | replace: '{day}', day | replace: '{month}', month -%}
          {%- else -%}
            {%- assign month = labels.months_short[month_index] -%}
            {%- assign formatted = labels.month_year | replace: '{month}', month -%}
          {%- endif -%}
          {%- assign formatted = formatted | replace: '{year}', date[0] %}
          — {{ labels.updated }}: {{ formatted }}
        {%- endif -%}
      </span>
      {%- if item.notebook %}
        <a
          href="{{ course.folder }}{{ item.notebook }}"
          download
          class="download-link"
          aria-label="{{ labels.download }} {{ item.notebook }}"
          title="{{ labels.download }}"
          ><i class="fa-solid fa-download fa-fw" aria-hidden="true"></i
        ></a>
      {%- endif %}
    </li>
  {%- endfor %}
</ul>
