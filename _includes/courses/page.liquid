{%- comment -%}
  Pagina dei materiali di un corso, generata dai dati: _data/courses.yml (struttura comune) e
  _data/<lingua>/courses_text.yml (testi). Uso: {% include courses/page.liquid course="econometrics" %}.
  Sezione (h2) → file della sezione (items) e/o blocchi (h3, es. settimane) → elenco dei file (ul/li).
  Nota della sezione (courses_text.yml, notes): sotto l'elenco, o sopra se la sezione ha note_first: true.
  Dettagli che si aprono (courses_text.yml, details): sempre in fondo alla sezione.
  Niente commenti HTML qui: nelle pagine .md kramdown li trasformerebbe in paragrafi vuoti.
{%- endcomment -%}
{%- assign course = site.data.courses[include.course] -%}
{%- assign texts = site.data[site.active_lang].courses_text -%}
{%- assign labels = texts.labels -%}
{%- assign course_text = texts[include.course] -%}
{%- assign course_text_en = site.data.en.courses_text[include.course] -%}
{%- for section in course.sections %}
  {%- assign section_title = course_text.sections[section.key] -%}
  {%- include section-toggle.liquid id=section.id title=section_title expanded=true %}
  <div id="{{ section.id }}" class="toggle-section expanded">
    {%- assign note = course_text.notes[section.key] -%}
    {%- assign details = course_text.details[section.key] -%}
    {%- if note and section.note_first %}
      <div class="course-note course-note--first">
        <p>{{ note }}</p>
      </div>
    {%- endif -%}
    {%- if section.items -%}
      {%- if section.blocks -%}
        {%- assign list_class = 'course-list course-list--spaced' -%}
      {%- else -%}
        {%- assign list_class = 'course-list' -%}
      {%- endif -%}
      {%- include courses/list.liquid items=section.items icon=section.icon list_class=list_class %}
    {%- endif -%}
    {%- if section.blocks -%}
      {%- for block in section.blocks %}
        {%- include section-toggle.liquid id=block.id title=block.title expanded=true tag='h3' class='subsection' wrapper='subsection' %}
        <div id="{{ block.id }}" class="toggle-section expanded">
          {%- unless forloop.last -%}
            {%- assign list_class = 'course-list course-list--spaced' -%}
          {%- else -%}
            {%- assign list_class = 'course-list' -%}
          {%- endunless -%}
          {%- include courses/list.liquid items=block.items icon=section.icon list_class=list_class %}
        </div>
      {%- endfor -%}
    {%- endif %}
    {%- if section.note_first -%}
      {%- assign note = null -%}
    {%- endif -%}
    {%- if note or details %}
      <div class="course-note">
        {%- if note %}
          <p>{{ note }}</p>
        {%- endif -%}
        {%- if details %}
          <details>
            <summary>{{ details.summary }}</summary>
            {{ details.body }}
          </details>
        {%- endif %}
      </div>
    {%- endif %}
  </div>
{%- endfor %}
