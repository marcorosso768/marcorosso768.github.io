<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive{% if include.limit and site.announcements.scrollable and news_size > 3 %} news-scrollable{% endif %}"
    >
      {% assign news = site.news | reverse %}
      {% if include.limit %}
        {% comment %} homepage: le ultime notizie in un'unica tabella {% endcomment %}
        {% if site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        <table class="table table-sm table-borderless">
          {% for item in news limit: news_limit %}
            {% include news/row.liquid item=item limit='true' %}
          {% endfor %}
        </table>
      {% else %}
        {% comment %} pagina news: notizie raggruppate per anno, con l'anno come titolo (h2) {% endcomment %}
        {% comment %} un titolo e una tabella nuova a ogni cambio d'anno (le notizie sono già in ordine di data) {% endcomment %}
        {% assign current_year = '' %}
        {% for item in news %}
          {% assign item_year = item.date | date: '%Y' %}
          {% if item_year != current_year %}
            {% unless forloop.first %}</table>{% endunless %}
            <h2 class="news-year">{{ item_year }}</h2>
            <table class="table table-sm table-borderless">
              {% assign current_year = item_year %}
          {% endif %}
          {% include news/row.liquid item=item %}
          {% if forloop.last %}</table>{% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% else %}
    <p>{{ site.data[site.active_lang].strings.no_news }}</p>
  {% endif %}
</div>
