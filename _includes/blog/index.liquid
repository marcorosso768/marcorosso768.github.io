{% comment %}
  Indice del blog, comune alle tre lingue (_pages/<lingua>/blog.md passano titolo, sottotitolo, nota e "min read").
  I post sono solo in inglese: l'elenco viene da site.data.blog_posts (_plugins/blog-posts-all-langs.rb),
  perche' nelle build it/es site.posts e' vuoto.
{% endcomment %}
{% comment %}archivi di tag e anni nella lingua della pagina: /it/blog/tag/... (static_href: polyglot non aggiunge il prefisso a /blog/){% endcomment %}
{% assign blog_prefix = '' %}
{% if site.active_lang != site.default_lang %}{% assign blog_prefix = '/' | append: site.active_lang %}{% endif %}
<div class="post">
  <div class="header-bar">
    <h1>{{ page.blog_name }}</h1>
    <h2>{{ page.description }}</h2>
    {% if page.note %}
      <p class="blog-note">{{ page.note }}</p>
    {% endif %}
  </div>

  {% if site.display_tags.size > 0 or site.display_categories.size > 0 %}
    <div class="tag-category-list">
      <ul class="p-0 m-0">
        {% for tag in site.display_tags %}
          <li>
            <i class="fa-solid fa-hashtag fa-sm"></i>
            <a
              {% static_href -%}
              href="{{ blog_prefix }}{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}"
              {% endstatic_href %}
            >
              {{- tag -}}
            </a>
          </li>
          {% unless forloop.last %}
            <p>&bull;</p>
          {% endunless %}
        {% endfor %}
        {% if site.display_categories.size > 0 and site.display_tags.size > 0 %}
          <p>&bull;</p>
        {% endif %}
        {% for category in site.display_categories %}
          <li>
            <i class="fa-solid fa-tag fa-sm"></i>
            <a
              {% static_href -%}
              href="{{ blog_prefix }}{{ category | slugify | prepend: '/blog/category/' | append: '/' | relative_url }}"
              {% endstatic_href %}
            >
              {{- category -}}
            </a>
          </li>
          {% unless forloop.last %}
            <p>&bull;</p>
          {% endunless %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% assign featured_posts = site.data.blog_posts | where: 'featured', true %}
  {% if featured_posts.size > 0 %}
    <div class="container featured-posts mt-4">
      <div class="row row-cols-1 row-cols-md-2">
        {% for post in featured_posts %}
          {% assign year = post.date | date: '%Y' %}
          <div class="col mb-4">
            <a href="{{ post.url | relative_url }}">
              <div class="card hoverable">
                <div class="card-body">
                  <div class="float-end"><i class="fa-solid fa-thumbtack fa-xs"></i></div>
                  <h3 class="card-title text-lowercase">{{ post.title }}</h3>
                  <p class="card-text">{{ post.description }}</p>
                  <p class="post-meta">
                    {{ post.read_time }}
                    {{ page.min_read | default: 'min read' }} &nbsp; &middot; &nbsp; {{ year }}
                  </p>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
    <hr>
  {% endif %}

  <ul class="post-list">
    {% for post in site.data.blog_posts %}
      {% assign year = post.date | date: '%Y' %}
      <li>
        <h3>
          <a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
        </h3>
        <p>{{ post.description }}</p>
        <p class="post-meta">
          {{ post.read_time }}
          {{ page.min_read | default: 'min read' }} &nbsp; &middot; &nbsp;
          {% include date_format.liquid format="long" date=post.date %}
        </p>
        <p class="post-tags">
          <a {% static_href %} href="{{ blog_prefix }}{{ year | prepend: '/blog/' | append: '/' | relative_url }}" {% endstatic_href %}
            ><i class="fa-solid fa-calendar fa-sm"></i> {{ year -}}
          </a>
          {% if post.tags.size > 0 %}
            &nbsp; &middot; &nbsp;
            {% for tag in post.tags %}
              <a
                {% static_href -%}
                href="{{ blog_prefix }}{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}"
                {% endstatic_href %}
                ><i class="fa-solid fa-hashtag fa-sm"></i> {{ tag -}}
              </a>
              {% unless forloop.last %}&nbsp;{% endunless %}
            {% endfor %}
          {% endif %}
        </p>
      </li>
    {% endfor %}
  </ul>
</div>
