<ul class="card-text fw-light list-group list-group-flush">
  {% for content in entry.contents %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12 col-md-2 d-flex flex-column align-items-center mb-2 mb-md-0">
          {% if content.year %}
            <span class="badge fw-bold danger-color-dark text-uppercase align-middle cv-badge">
              {{- content.year -}}
            </span>
          {% endif %}
          {% if content.location %}
            <p class="location text-center mt-2 mb-0 responsive-location">
              <i class="fa-solid fa-location-dot iconlocation fa-fw"></i>
              {{ content.location }}
            </p>
          {% endif %}
        </div>

        <div class="col-12 col-md-10 mt-2 mt-md-0">
          {% if content.title %}
            <h3 class="title fw-bold ms-1 ms-md-4 h6">{{ content.title }}</h3>
          {% endif %}
          {% if content.department or content.institution or content.firm or content.soccer or content.supervisor or content.cosupervisor %}
            <table class="table-cv ms-1 ms-md-4 institution">
              <tbody>
                {% if content.soccer %}
                  <tr>
                    <td class="cv-icon-cell soccer">
                      <i class="fa-regular fa-futbol fa-fw text-theme"></i>
                    </td>
                    <td class="soccer">{{ content.soccer }}</td>
                  </tr>
                {% endif %}
                {% if content.firm %}
                  <tr>
                    <td class="cv-icon-cell firm">
                      <i class="fa-solid fa-briefcase fa-fw text-theme"></i>
                    </td>
                    <td class="firm">{{ content.firm }}</td>
                  </tr>
                {% endif %}
                {% if content.institution %}
                  <tr>
                    <td class="cv-icon-cell institution">
                      <i class="fa-solid fa-building-columns iconinstitution fa-fw"></i>
                    </td>
                    <td class="institution">{{ content.institution }}</td>
                  </tr>
                {% endif %}
                {% if content.department %}
                  <tr>
                    <td class="cv-icon-cell department">
                      <i class="fa-solid fa-school icondepartment fa-fw"></i>
                    </td>
                    <td class="department">{{ content.department }}</td>
                  </tr>
                {% endif %}
                {% if content.supervisor %}
                  <tr>
                    <td class="cv-icon-cell supervisor">
                      <i class="fa-solid fa-circle-user iconsupervisor fa-fw"></i>
                    </td>
                    <td class="supervisor">{{ content.supervisor }}</td>
                  </tr>
                {% endif %}
                {% if content.cosupervisor %}
                  <tr>
                    <td class="cv-icon-cell supervisor">
                      <i class="fa-solid fa-circle-user iconsupervisor fa-fw"></i>
                    </td>
                    <td class="supervisor">{{ content.cosupervisor }}</td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          {% endif %}
          {% if content.maindescription %}
            {% comment %} descrizione del ruolo: in cv.yml solo il testo, l'aspetto è qui e in _cv.scss {% endcomment %}
            <div class="ms-1 ms-md-4">
              <p class="cv-description">
                <span class="cv-description__marker" aria-hidden="true">&gt;</span>
                <i class="cv-description__text">{{ content.maindescription }}</i>
              </p>
            </div>
          {% endif %}
          {% if content.description %}
            <ul class="items">
              {% for item in content.description %}
                <li>
                  {% if item.contents %}
                    <span class="item-title">{{ item.title }}</span>
                    <ul class="subitems">
                      {% for subitem in item.contents %}
                        <li>
                          <span class="subitem">{{ subitem }}</span>
                        </li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    <span class="item">{{ item }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if content.items %}
            <ul class="items">
              {% for item in content.items %}
                <li>
                  {% if item.contents %}
                    <span class="item-title">{{ item.title }}</span>
                    <ul class="subitems">
                      {% for subitem in item.contents %}
                        <li>
                          <span class="subitem">{{ subitem }}</span>
                        </li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    <span class="item">{{ item }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if content.linkitems %}
            <div class="container-links ms-1 ms-md-4">
              {% for item in content.linkitems %}
                {% if item.link %}
                  <div class="container-link-button">
                    {% if item.linkname %}
                      <a href="{{ item.link }}" class="btncv z-depth-0">{{ item.linkname }}</a>
                    {% else %}
                      <a href="{{ item.link }}" class="btncv z-depth-0">doc</a>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
