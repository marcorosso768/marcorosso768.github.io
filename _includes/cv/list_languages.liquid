<div class="list-languages flex-container ms-2 ms-sm-4">
  {% for content in entry.contents %}
    <div class="list-language flex-item">
      <table class="table-cv list-language-table">
        <tbody>
          <tr>
            {% comment %} una sola colonna: niente colspan (prima valeva voci + 1 e rendeva la tabella non valida) {% endcomment %}
            <td class="list-language-category">{{ content.category }}</td>
          </tr>
          {% for item in content.items %}
            <tr>
              <td class="list-language-name">
                <b>{{ item.name }}</b>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
