<ul class="card-text fw-light list-group list-group-flush">
  {% for content in entry.contents %}
    <li class="list-group-item">
      <h3 class="fst-italic h5">{{ content.title }}</h3>
      {% if content.items %}
        <ul class="subitems">
          {% for subitem in content.items %}
            <li>
              <span class="subitem">{{ subitem }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
