<table class="table table-cv table-sm table-borderless table-responsive ms-1 ms-sm-3">
  {% for content in entry.contents %}
    <tr>
      <td class="p-1 pe-2 fw-bold">
        <b
          ><span class="cv-value">{{ content.name }}</span></b
        >
      </td>
      {% if content.value %}
        <td class="p-1 ps-2 fw-light text">
          {% comment %} div e non span: il valore può contenere blocchi (div), non ammessi dentro uno span {% endcomment %}
          {% if content.icon %}
            {% comment %} voce con icona (riviste, affiliazioni): icona e testo in cv.yml, aspetto in _cv.scss {% endcomment %}
            <div class="cv-value cv-icon-item">
              <i class="{{ content.icon }} fa-fw cv-icon-item__icon"></i>
              <div class="cv-icon-item__text">{{ content.value }}</div>
            </div>
          {% else %}
            <div class="cv-value">{{ content.value }}</div>
          {% endif %}
        </td>
      {% endif %}
      {% if content.links %}
        <td class="p-1 ps-2 fw-light text">
          <div class="container-pdf">
            {% for item in content.links %}
              {% if item.link %}
                <div class="container-link-button">
                  {% if item.name %}
                    <a href="{{ item.link }}" class="btncv z-depth-0">{{ item.name }}</a>
                  {% else %}
                    <a href="{{ item.link }}" class="btncv z-depth-0">doc</a>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </td>
      {% endif %}
    </tr>
  {% endfor %}
</table>
