{% comment %}
  Homepage: gli ultimi post del blog, nella stessa tabella delle news (data breve nella lingua della pagina).
  I post sono solo in inglese: l'elenco viene da site.data.blog_posts (_plugins/blog-posts-all-langs.rb),
  perché nelle build it/es site.posts è vuoto.
{% endcomment %}
<div class="news latest-posts">
  {% assign latest_posts_all = site.data.blog_posts %}
  {% if latest_posts_all.size > 0 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in latest_posts_all limit: site.latest_posts.limit %}
          <tr>
            <th scope="row" class="news-date">
              {% include date_format.liquid format='short' date=item.date %}
            </th>
            <td>
              <a class="news-title link-own" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% endif %}
</div>
