<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Connessioni anticipate ai CDN (risparmiano il tempo di apertura della connessione) -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

<!-- Bootstrap + sottoinsieme di MDB usato dal sito (vedi assets/css/mdb-subset.css) -->
<link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">
<link rel="stylesheet" href="{{ '/assets/css/mdb-subset.css' | relative_url | bust_file_cache }}">

<!-- Bootstrap Table -->
{% if page.pretty_table %}
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.bootstrap-table.url.css }}"
    integrity="{{ site.third_party_libraries.bootstrap-table.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- Preload dei font delle icone della barra di navigazione (evita che compaiano in ritardo) -->
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/webfonts/fa-solid-900.woff2' | relative_url }}">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/tabler-icons.woff2' | relative_url }}?v3.0.1">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/roboto/roboto-latin-300.woff2' | relative_url }}">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/roboto/roboto-latin-400.woff2' | relative_url }}">
<link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/roboto/roboto-latin-700.woff2' | relative_url }}">

<!-- Fonts & Icons -->
<!-- caricati senza bloccare la prima visualizzazione: le icone accademiche e il font compaiono appena pronti -->
<link
  rel="stylesheet"
  href="{{ '/assets/css/academicons.min.css' | relative_url | bust_file_cache }}"
  media="print"
  onload="this.media='all'"
>
{% comment %}
  Roboto in locale: le @font-face sono in linea perche' un foglio separato sarebbe
  una richiesta bloccante in piu' sul percorso critico. I file sono in assets/fonts/roboto
  (SIL Open Font License, licenza nella stessa cartella).
{% endcomment %}
{% capture roboto_range %}U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD{% endcapture %}
<style>
  {% assign roboto_weights = "300,400,500,700" | split: "," %}
  {% for w in roboto_weights %}
    @font-face {
      font-family: "Roboto";
      font-style: normal;
      font-weight: {{ w }};
      font-display: swap;
      src: url("{{ '/assets/fonts/roboto/roboto-latin-' | append: w | append: '.woff2' | relative_url }}") format("woff2");
      unicode-range: {{ roboto_range }};
    }
  {% endfor %}
</style>
<noscript>
  <link rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url | bust_file_cache }}">
</noscript>

<!-- Code Syntax Highlighting: solo nelle pagine che contengono codice -->
{% assign has_code = false %}
{% if page.content contains '<pre' or page.content contains '```' or page.content contains 'language-' or page.pseudocode or page.code_diff %}
  {% assign has_code = true %}
{% endif %}
{% if has_code %}
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
    media=""
    id="highlight_theme_light"
  >
{% endif %}

{% if page.toc and page.toc.sidebar %}
  <!-- Sidebar Table of Contents -->
  <link defer href="{{ '/assets/css/bootstrap-toc.min.css' | relative_url | bust_file_cache }}" rel="stylesheet">
{% endif %}

<!-- Styles -->

<!-- pseudocode -->
{% if page.pseudocode %}
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.icon contains 'favicons/' %}
  <!-- Add apple-mobile-web-app-title meta tag in HTML -->
  <meta name="apple-mobile-web-app-title" content="MR">
  <!--
    Favicon statiche (Safari legge quelle presenti nell'HTML). Lo script dopo theme.js le allinea al tema del sito. Per aggiornarle, nuova cartella (v4, ...)
  -->
  <link rel="icon" type="image/svg+xml" data-favicon="svg" href="{{ '/assets/img/favicons/v3/favicon_light/favicon.svg' | relative_url }}">
  <link
    rel="icon"
    type="image/png"
    sizes="96x96"
    data-favicon="png"
    href="{{ '/assets/img/favicons/v3/favicon_light/favicon-96x96.png' | relative_url }}"
  >
  <link
    rel="icon"
    type="image/png"
    sizes="96x96"
    data-favicon="png-dark"
    href="{{ '/assets/img/favicons/v3/favicon_dark/favicon-96x96.png' | relative_url }}"
    media="(prefers-color-scheme: dark)"
  >
  <link rel="shortcut icon" data-favicon="ico" href="{{ '/favicon.ico' | relative_url }}">
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    data-favicon="apple"
    href="{{ '/assets/img/favicons/v3/favicon_light/apple-touch-icon.png' | relative_url }}"
  >
  <link rel="manifest" href="{{ '/assets/img/favicons/v3/favicon_light/site.webmanifest' | relative_url }}">
{% else %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

<!-- Language -->
{% include hreflang.liquid %}
<script id="urlMapData" type="application/json">
  {{ site.data.url_map | jsonify }}
</script>
<script src="/assets/js/language-toggle.js" defer></script>

<!-- Dark Mode -->
<script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
{% if site.icon contains 'favicons/' %}
  <script>
    {% include scripts/favicon_theme.js %}
  </script>
{% endif %}
{% if site.enable_darkmode %}
  {% if has_code %}
    <link
      defer
      rel="stylesheet"
      href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
      media="none"
      id="highlight_theme_dark"
    >
  {% endif %}
  <script>
    initTheme();
  </script>
{% endif %}

<!-- GeoJSON support via Leaflet -->
{% if page.map %}
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- diff2html -->
{% if page.code_diff %}
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: light)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: dark)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.images %}
  <!-- Image comparison slider -->
  {% if page.images.compare %}
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.img-comparison-slider.url.css }}"
      integrity="{{ site.third_party_libraries.img-comparison-slider.integrity.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
  <!-- Image slider -->
  {% if page.images.slider %}
    <link
      defer
      rel="stylesheet"
      href="{{ site.third_party_libraries.swiper.url.css }}"
      integrity="{{ site.third_party_libraries.swiper.integrity.css }}"
      crossorigin="anonymous"
    >
  {% endif %}
{% endif %}

{% if page.tikzjax %}
  <link defer rel="stylesheet" type="text/css" href="https://tikzjax.com/v1/fonts.css">
{% endif %}
