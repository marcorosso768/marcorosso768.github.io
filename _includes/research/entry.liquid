{%- comment -%}
  Una voce della pagina research. Parametro: key (chiave in _data/research.yml → entries).
  Ordine fisso: titolo (h3), coautori, serie (prima il link ssrn, poi | e series · isbn, tutto nel link series_url: l'ISBN è del WP);
  sotto, la riga coverage (chi ha ripreso il paper: Featured in / Citato da; link su nome e data); pillole-link; pillole delle caselle;
  per ultima la pillola della bozza su richiesta (draft_request: il paper esiste ma non è pubblico); caselle.
{%- endcomment -%}
{%- assign key = include.key -%}
{%- assign e = site.data.research.entries[key] -%}
{%- assign t = site.data[site.active_lang].research_text.entries[key] -%}
{%- assign labels = site.data[site.active_lang].research_text.labels -%}
{%- comment -%}
  Riquadro a sinistra (come il livello dei corsi in teaching): JMP nella sezione del job market paper; WiP per i work in progress; WP se il paper è pubblico (url); Draft se non lo è ancora;
  per le tesi il livello (PhD/MA/BA, etichette di teaching_text.yml). Le pubblicazioni non hanno riquadro.
  Lo stato (status: submitted…) resta un'etichetta dopo il titolo.
{%- endcomment -%}
{%- assign badge = null -%}
{%- if include.section == 'jmp' -%}
  {%- assign badge = labels.badges.jmp -%}
{%- elsif e.icon == 'wip' -%}
  {%- assign badge = labels.badges.wip -%}
{%- elsif e.icon == 'working_paper' and e.url -%}
  {%- assign badge = labels.badges.wp -%}
{%- elsif e.icon == 'working_paper' -%}
  {%- assign badge = labels.badges.draft -%}
{%- elsif e.icon == 'thesis' -%}
  {%- case e.degree -%}
    {%- when 'phd' -%}
      {%- assign level = 'phd' -%}
    {%- when 'master' -%}
      {%- assign level = 'ma' -%}
    {%- else -%}
      {%- assign level = 'ba' -%}
  {%- endcase -%}
  {%- assign badge = site.data[site.active_lang].teaching_text.labels.levels[level] -%}
{%- endif %}
<div class="entry-block{% if e.icon == 'publication' %} entry-block--reference{% else %} entry-block--badge{% endif %}">
  <div class="icon-entry indented">
    {%- unless e.icon == 'publication' %}
      <span class="research-badge">
        {%- if badge -%}
          <span class="level-badge">{{ badge }}</span>
        {%- endif -%}
      </span>
    {%- endunless %}
    <div class="entry-text">
      <h3 class="entry-title">
        {%- case e.icon -%}
          {%- when 'publication' -%}
            {{ e.authors | escape | replace: 'Rosso M.', '<b>Rosso M.</b>' }} ({{ e.year }}). <a href="{{ e.url }}">{{ e.title | escape }}</a>
            <i>{{ e.journal | escape }}</i>,
            {{ e.details | escape }}
          {%- when 'thesis' -%}
            <span class="visually-hidden">{{ site.data[site.active_lang].research_text.degrees[e.degree] }}: </span>
            {{- e.title | escape -}}
          {%- else -%}
            {%- if e.url -%}
              <a href="{{ e.url }}">{{ e.title | escape }}</a>
            {%- else -%}
              {{ e.title | escape }}
            {%- endif -%}
            {%- if e.status %}
              <span class="paper-status">{{ labels.status[e.status] }}</span>
            {%- endif -%}
        {%- endcase -%}
      </h3>
      {%- if e.coauthors %}
        {{ labels.joint_with }}
        {%- assign count = e.coauthors | size -%}
        {%- for person_key in e.coauthors -%}
          {%- assign person = site.data.people[person_key] -%}
          {%- if forloop.first -%}
            {{ ' ' }}
          {%- elsif forloop.last -%}
            {%- if count > 2 %}, {{ labels.and }} {% else %} {{ labels.and }} {% endif -%}
          {%- else -%}
            {{ ', ' }}
          {%- endif -%}
          <a href="{{ person.url }}">{{ person.name }}</a>
        {%- endfor -%}
      {%- endif -%}
      {%- if e.series %}
        {%- if e.coauthors %}<br>{% endif %}
        <span class="paper-series">
          {%- if e.ssrn -%}
            <a class="paper-series__link" href="{{ e.ssrn }}">SSRN</a> |{{ ' ' }}
          {%- endif -%}
          {%- capture series_text -%}
            {{ e.series }}{% if e.isbn %} · ISBN {{ e.isbn }}{% endif %}
          {%- endcapture -%}
          {%- if e.series_url -%}
            <a class="paper-series__link" href="{{ e.series_url }}">{{ series_text }}</a>
          {%- else -%}
            {{ series_text }}
          {%- endif -%}
        </span>
      {%- endif %}
      {%- if e.coverage %}
        <br>
        <span class="paper-series">
          {{- labels.coverage }}:{{ ' ' }}
          {%- for item in e.coverage -%}
            {%- assign when = '' -%}
            {%- if item.date -%}
              {%- assign month_index = item.date | slice: 5, 2 | plus: 0 | minus: 1 -%}
              {%- assign year = item.date | slice: 0, 4 -%}
              {%- assign when = labels.month_year
                | replace: '{month}', labels.months[month_index]
                | replace: '{year}', year
                | prepend: ' ('
                | append: ')'
              -%}
            {%- endif -%}
            <a class="paper-series__link" href="{{ item.url }}">
              {{- item.name -}}
              {{- when -}}
            </a>
            {%- unless forloop.last %}, {% endunless -%}
          {%- endfor -%}
        </span>
      {%- endif %}
    </div>
    {%- if e.icon == 'thesis' %}
      <span class="entry-year">{{ e.year }}</span>
    {%- endif %}
  </div>
  {%- if e.links or e.panels %}
    <div class="pill-container mt-2">
      {%- for link in e.links -%}
        {%- if link.type == 'draft_request' -%}{%- continue -%}{%- endif %}
        <a href="{{ link.url }}" class="pill-link no-external">
          <i class="fa-solid fa-file-lines fa-2xs"></i>
          <span class="toggle-label" title="{{ link.title | escape }}">{{ labels.working_paper }}</span>
        </a>
      {%- endfor -%}
      {%- for panel in e.panels %}
        <button
          type="button"
          class="pill-button toggle-pill"
          data-target="{{ panel }}-{{ key }}"
          aria-controls="{{ panel }}-{{ key }}"
          aria-expanded="false"
        >
          <i class="fa-solid fa-chevron-right fa-2xs" aria-hidden="true"></i>
          <span class="toggle-label">{{ labels[panel] }}</span>
        </button>
      {%- endfor -%}
      {%- for link in e.links -%}
        {%- if link.type == 'draft_request' -%}
          {%- assign subject = labels.draft_subject | replace: '{title}', e.title | url_encode | replace: '+', '%20' -%}
          {%- assign body = labels.draft_body | replace: '{title}', e.title | url_encode | replace: '+', '%20' %}
          <a href="mailto:{{ labels.draft_email }}?subject={{ subject }}&amp;body={{ body }}" class="pill-link no-external">
            <i class="fa-solid fa-envelope fa-2xs"></i>
            <span class="toggle-label" title="{{ labels.draft_title }}">{{ labels.draft }}</span>
          </a>
        {%- endif -%}
      {%- endfor %}
    </div>
  {%- endif -%}
  {%- for panel in e.panels -%}
    {%- case panel -%}
      {%- when 'abstract' -%}
        {%- assign content = t.abstract | default: e.abstract -%}
      {%- when 'keywords' -%}
        {%- assign content = t.keywords | default: e.keywords -%}
      {%- when 'jel' -%}
        {%- assign content = e.jel -%}
    {%- endcase -%}
    {%- if panel == 'cite' %}
      <div id="cite-{{ key }}" class="toggle-box">
        <pre class="bibtex" id="bibtex-{{ key }}">{{ e.bibtex | escape }}</pre>
        <button type="button" class="download-bibtex" data-copy-target="bibtex-{{ key }}" aria-label="{{ labels.download_aria }}">
          {{- labels.download -}}
        </button>
        <button type="button" class="copy-bibtex" data-copy-target="bibtex-{{ key }}" aria-label="{{ labels.copy_aria }}">{{ labels.copy }}</button>
      </div>
    {%- else %}
      <div id="{{ panel }}-{{ key }}" class="toggle-box">
        {{ content }}
      </div>
    {%- endif -%}
  {%- endfor %}
</div>
