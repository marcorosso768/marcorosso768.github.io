{% if page.chart and page.chart.chartjs %}
  <script
    defer
    src="{{ site.third_party_libraries.chartjs.url.js }}"
    integrity="{{ site.third_party_libraries.chartjs.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.language-chartjs').forEach(function (el) {
        const text = el.textContent;
        const canvas = document.createElement('canvas');
        el.textContent = '';
        el.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        ctx && text && new Chart(ctx, JSON.parse(text)) && el.setAttribute('data-processed', true);
      });
    });
  </script>
{% endif %}
