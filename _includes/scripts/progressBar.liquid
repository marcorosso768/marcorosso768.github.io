{% if site.enable_progressbar %}
  <!-- Scrolling Progress Bar -->
  <script>
    /*
     * This JavaScript code has been adapted from the article
     * https://css-tricks.com/reading-position-indicator/ authored by Pankaj Parashar,
     * published on the website https://css-tricks.com on the 7th of May, 2014.
     * Couple of changes were made to the original code to make it compatible
     * with the `al-foio` theme.
     */
    // (senza jQuery: stesso comportamento della versione precedente)
    const progressBar = document.getElementById('progress');
    /*
     * We set up the bar after all elements are done loading.
     * In some cases, if the images in the page are larger than the intended
     * size they'll have on the page, they'll be resized via CSS to accomodate
     * the desired size. This mistake, however, breaks the computations as the
     * scroll size is computed as soon as the elements finish loading.
     * To account for this, a minimal delay was introduced before computing the
     * values.
     */
    window.onload = function () {
      setTimeout(progressBarSetup, 50);
    };
    function progressBarSetup() {
      if (!progressBar) return;
      initializeProgressElement();
      document.addEventListener('scroll', function () {
        progressBar.value = getCurrentScrollPosition();
      });
      window.addEventListener('resize', initializeProgressElement);
    }
    // The vertical scroll position is how much the user has scrolled from the top
    function getCurrentScrollPosition() {
      return window.scrollY;
    }
    // altezza della barra di navigazione compresi i margini, come outerHeight(true) di jQuery
    function navbarOuterHeight() {
      const navbar = document.getElementById('navbar');
      if (!navbar) return 0;
      const style = getComputedStyle(navbar);
      return navbar.getBoundingClientRect().height + parseFloat(style.marginTop) + parseFloat(style.marginBottom);
    }
    function initializeProgressElement() {
      const navbarHeight = navbarOuterHeight();
      document.body.style.paddingTop = navbarHeight + 'px';
      progressBar.style.top = navbarHeight + 'px';
      progressBar.max = getDistanceToScroll();
      progressBar.value = getCurrentScrollPosition();
    }
    // This is the distance the user can scroll
    function getDistanceToScroll() {
      return document.documentElement.scrollHeight - window.innerHeight;
    }
  </script>
{% endif %}
