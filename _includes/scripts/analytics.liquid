{% if site.enable_google_analytics %}
  <!-- Global site tag (gtag.js) - Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', '{{ site.google_analytics }}');
  </script>
{% endif %}
{% if site.enable_cronitor_analytics %}
  <!-- Cronitor RUM -->
  <script async src="https://rum.cronitor.io/script.js"></script>
  <script>
    window.cronitor =
      window.cronitor ||
      function () {
        (window.cronitor.q = window.cronitor.q || []).push(arguments);
      };
    cronitor('config', { clientKey: '{{site.cronitor_analytics}}' });
  </script>
{% endif %}
{% if site.enable_pirsch_analytics %}
  <script
    defer
    src="https://api.pirsch.io/pa.js"
    id="pianjs"
    data-code="{{ site.pirsch_analytics }}"
  ></script>
{% endif %}
{% if site.enable_goatcounter_analytics and site.goatcounter_analytics %}
  <!-- GoatCounter: statistiche senza cookie -->
  <script
    data-goatcounter="https://{{ site.goatcounter_analytics }}.goatcounter.com/count"
    async
    src="https://gc.zgo.at/count.js"
  ></script>
  <script>
    // download come eventi GoatCounter: un solo listener, lavora solo al clic, nessun costo al caricamento
    document.addEventListener(
      'click',
      function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a || !window.goatcounter || !window.goatcounter.count) return;
        var url = a.href.split(/[?#]/)[0];
        if (!/\.(pdf|ipynb|do|dta|r|py|zip|xlsx?|csv|pptx?|docx?)$/i.test(url)) return;
        var name = decodeURIComponent(url.split('/').pop());
        window.goatcounter.count({ path: 'download: ' + name, title: name, event: true });
      },
      true
    );
  </script>
{% endif %}
