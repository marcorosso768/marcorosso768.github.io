{%- comment -%}
  Pagina "materials": indice dei corsi con materiali, generato dai dati. Ordine e dati del corso da _data/teaching.yml
  (campo materials = chiave del corso in _data/courses.yml), testi da _data/<lingua>/teaching_text.yml, sezioni e numero
  di file da _data/courses.yml e _data/<lingua>/courses_text.yml. Si aggiorna da sola quando si aggiunge un file o un corso.
  Diviso per ruolo come la pagina teaching (docente / tutor didattico): una sezione apribile per ruolo, solo se ha corsi
  con materiali.
  Riepilogo per corso: sezioni con il numero di file (le voci di solo testo, note, non contano); una sezione con
  in_summary: false in courses.yml non compare (es. informazioni sul corso).
  Niente commenti HTML qui: nelle pagine .md kramdown li trasformerebbe in paragrafi vuoti.
{%- endcomment -%}
{%- assign texts = site.data[site.active_lang].teaching_text -%}
{%- assign course_texts = site.data[site.active_lang].courses_text -%}
{%- for section in site.data.teaching.sections -%}
  {%- assign has_materials = false -%}
  {%- for group in section.groups -%}
    {%- for institution in group.institutions -%}
      {%- for course_key in institution.courses -%}
        {%- if site.data.teaching.courses[course_key].materials -%}
          {%- assign has_materials = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- unless has_materials -%}
    {%- continue -%}
  {%- endunless -%}
  {%- assign section_id = 'materials-' | append: section.key -%}
  {%- assign section_title = texts.sections[section.key].title %}
  {%- include section-toggle.liquid id=section_id title=section_title expanded=true %}
  <div id="{{ section_id }}" class="toggle-section expanded">
    <ul class="materials-index">
      {%- for group in section.groups -%}
        {%- for institution in group.institutions -%}
          {%- for course_key in institution.courses -%}
            {%- assign course = site.data.teaching.courses[course_key] -%}
            {%- unless course.materials -%}
              {%- continue -%}
            {%- endunless -%}
            {%- assign text = texts.courses[course_key] -%}
            {%- assign files = site.data.courses[course.materials] -%}
            {%- assign files_text = course_texts[course.materials] %}
            <li class="materials-entry">
              <h2 class="materials-entry__title">
                <a href="{{ text.materials }}">
                  <i class="fa-regular fa-folder fa-fw" aria-hidden="true"></i>
                  <i class="fa-regular fa-folder-open fa-fw" aria-hidden="true"></i>
                  {{ text.title -}}
                </a>
              </h2>
              <div class="materials-entry__meta">{{ course.dates }} · {{ texts.institutions[institution.key] }}</div>
              <div class="materials-entry__meta">{{ text.program }}</div>
              <div class="materials-entry__sections">
                {%- assign shown = 0 -%}
                {%- for part in files.sections -%}
                  {%- if part.in_summary == false -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- assign count = 0 -%}
                  {%- for item in part.items -%}
                    {%- unless item.note -%}{%- assign count = count | plus: 1 -%}{%- endunless -%}
                  {%- endfor -%}
                  {%- for block in part.blocks -%}
                    {%- for item in block.items -%}
                      {%- unless item.note -%}{%- assign count = count | plus: 1 -%}{%- endunless -%}
                    {%- endfor -%}
                    {%- for item_group in block.groups -%}
                      {%- for item in item_group.items -%}
                        {%- unless item.note -%}{%- assign count = count | plus: 1 -%}{%- endunless -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  {%- endfor -%}
                  {%- if shown > 0 -%}
                    <span class="materials-entry__sep" aria-hidden="true">•</span>
                  {%- endif %}
                  {%- assign shown = shown | plus: 1 %}
                  <span>{{ files_text.sections[part.key] }} ({{ count }})</span>
                {%- endfor %}
              </div>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor %}
    </ul>
  </div>
{%- endfor %}
