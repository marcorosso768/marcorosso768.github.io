{% if site.footer_fixed %}
  <footer class="fixed-bottom">
    <div class="container mt-0">
      &copy; {{ site.time | date: '%Y' }}
      {{ site.first_name -}}
      {%- if site.middle_name %} {{ site.middle_name }}{% endif %}
      {{ site.last_name }}
      {{ site.data[site.active_lang].strings.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        {% comment %}
          Data con i mesi nella lingua della pagina (date_format.liquid): il filtro date di Ruby scrive i mesi solo in inglese
        {% endcomment %}
        {% assign current_lang = site.active_lang %}
        {% if current_lang == 'en' %}
          · Last updated:
        {% elsif current_lang == 'it' %}
          · Ultimo aggiornamento:
        {% elsif current_lang == 'es' %}
          · Última actualización:
        {% endif %}
        {% include date_format.liquid format='long' date='now' %}
      {% endif %}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5">
    {% if site.newsletter.enabled %}
      {% include scripts/newsletter.liquid %}
    {% endif %}

    <div class="container mt-0">
      &copy; {{ site.time | date: '%Y' }}
      {{ site.first_name -}}
      {%- if site.middle_name %} {{ site.middle_name }}{% endif %}
      {{ site.last_name }}
      {{ site.data[site.active_lang].strings.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        {% comment %}
          Data con i mesi nella lingua della pagina (date_format.liquid): il filtro date di Ruby scrive i mesi solo in inglese
        {% endcomment %}
        {% assign current_lang = site.active_lang %}
        {% if current_lang == 'en' %}
          · Last updated:
        {% elsif current_lang == 'it' %}
          · Ultimo aggiornamento:
        {% elsif current_lang == 'es' %}
          · Última actualización:
        {% endif %}
        {% include date_format.liquid format='long' date='now' %}
      {% endif %}
    </div>
  </footer>
{% endif %}
